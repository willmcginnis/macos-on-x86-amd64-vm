{
 "meta": {
  "what": "Every entry of the kernel collection the furthest 27-only root booted with.",
  "as_of": "2026-11-08",
  "evidence": "measured",
  "how": "Each entry's Mach-O UUID was compared with the 27.0.1 Kernel Debug Kit's x86_64 kexts and with the set of kexts borrowed from macOS 26.",
  "classes": {
   "apple-27-x86_64": "Apple's own 27.0.1 x86_64 kext from the Kernel Debug Kit",
   "borrowed-tahoe-x86_64": "an x86_64 kext from macOS 26 (Tahoe); for 8 of the 9, 27.0.1 ships no x86_64 build of it, and AppleRTC is the exception (27.0.1 has one, not yet swapped in)",
   "apple-27-lifted": "Apple's own 27.0.1 arm64e kext, recompiled to x86_64 by the project's lifter",
   "self-built-kernel": "the kernel itself, built by the project from Apple's published xnu source (see docs/components.md)"
  }
